    {
        "id": "954a9d48bcfeeae2",
        "type": "function",
        "z": "3cb080970f5cb5f3",
        "name": "轉換成BBox座標",
        "func": "// 取得檔案內容的陣列, 一行是一個元素, 這是使用\"\\n\"來切割 Buffer\nlet annotations = msg.annotations.toString().split('\\n');\n// 初始 msg.annotations 屬性\nmsg.annotations = [];\n// 使用 for 迴圈來處理陣列的每一行資料\nfor (let i = 0; i < annotations.length; i++) {\n    let line = annotations[i].trim(); // 刪除空白\n    // 跳過空白行\n    if (!line) continue;\n    // 將每一行的資料, 使用空白字元分割成數字陣列\n    let parts = line.split(' ').map(Number);\n    // 取出分類索引和邊界框資料x, y, width, height\n    let classIndex = parts[0];\n    let centerX = parts[1];\n    let centerY = parts[2];\n    let width = parts[3];\n    let height = parts[4];\n    // console.log(\"YOLO:\", classIndex, centerX, centerY, width, height);\n    // 將 YOLO 格式轉換為 bbox 格式 (x, y, width, height)\n    let bbox_x = (centerX - width / 2) * msg.width;\n    let bbox_y = (centerY - height / 2) * msg.height;\n    let bbox_width = width * msg.width;\n    let bbox_height = height * msg.height;\n    // console.log(\"BBOX:\", bbox_x, bbox_y, bbox_width, bbox_height);\n    // 建立每一筆標註資料的 JSON 物件\n    let jsondata = {\n        label: msg.classNames[classIndex], // 根據索引取得分類名稱\n        bbox: [bbox_x, bbox_y, bbox_width, bbox_height],\n        labelLocation: \"top\" // 預設標籤位置為 \"top\"\n    }\n    // console.log(jsondata)\n    // 新增一個標註物件\n    msg.annotations.push(jsondata);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
