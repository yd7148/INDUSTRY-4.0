nce":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":210,"y":680,"wires":[["aa96f49f88451f89"]]},{"id":"0a180a32f1b57092","type":"comment","z":"887c29a367575eb8","name":"update","info":"","x":550,"y":620,"wires":[]},{"id":"7918ac30acdeb2e0","type":"function","z":"887c29a367575eb8","name":"20260822 Ceate Query","func":"let d = new Date();\n\n// 自動補零函數 (例如: 9 -> \"09\")\nlet pad = (num) => String(num).padStart(2, '0');\n\nlet myear = d.getFullYear();\nlet mmonth = pad(d.getMonth() + 1);\nlet mday = pad(d.getDate());\nlet mhour = pad(d.getHours());\nlet mmin = pad(d.getMinutes());\nlet msec = pad(d.getSeconds());\n\n// 日期格式: YYYY-MM-DD\nlet mdate = `${myear}-${mmonth}-${mday}`;\n\n// 時間格式: HH:mm:ss (使用冒號非斜線)\nlet mtime = `${mhour}:${mmin}:${msec}`;\n\nlet m_topic = msg.topic;\nlet m_payload = msg.payload;\n\n// 建議使用 VALUES (複數)\nlet strQuery = `\nINSERT INTO mytable (topic, payload, mdate, mtime, deleted)\nVALUES ('${m_topic}', '${m_payload}', '${mdate}', '${mtime}', 0)\n`;\n\nmsg.topic = strQuery;\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":890,"y":80,"wires":[[]]},{"id":"d99519580c9826f3","type":"function","z":"887c29a367575eb8","name":"Ceate Query","func":"let d = new Date()\nlet myear = d.getFullYear()\nlet mmonth = d.getMonth()+1\nlet mday = d.getDate()\nlet mhour = d.getHours()\nlet mmin = d.getMinutes()\nlet msec = d.getSeconds()\n\nlet mdate = myear + \"-\" + mmonth + \"-\" +mday\nlet mtime = mhour + \":\" + mmin + \":\" + msec \n\nlet m_topic = msg.topic\nlet m_payload = msg.payload\n\nlet strQuery =`\nINSERT INTO mytable(topic, payload, mdate, mtime, deleted) VALUES ('${m_topic}', '${m_payload}', '${mdate}', '${mtime}', 0)\n`\nmsg.topic = strQuery\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":570,"y":160,"wires":[["feaac5810532e763"]]},{"id":"448964f1ea3d8e9e","type":"MySQLdatabase","name":"","host":"127.0.0.1","port":"3306","db":"mymqtt2","tz"