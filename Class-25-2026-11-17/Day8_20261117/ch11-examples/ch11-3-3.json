    {
        "id": "18e9e215c57abe6b",
        "type": "function",
        "z": "c75b7d1c39b68e7b",
        "name": "分類數量計數",
        "func": "// 設定欲統計的分類和信心指數\nvar className = \"person\"; // 您可以根據需要更改為任何類別\nvar probability = 0.9;    // 請更改信心指數的門檻\n\n// 設定欲統計的類別 - 如果msg.topic不是空的，使用msg.topic作為目標分類\nvar targetClass = (msg.topic && msg.topic !== \"\") ? msg.topic : className;\n// 設定信心指數的門檻 - 如果msg.prob不是空的，使用msg.prob作為信心指數的門檻\nvar targetProb = (msg.prob && msg.prob !== \"\") ? msg.prob : probability;\n// 初始化計數器\nvar count = 0;\n// 檢查是否有偵測到的物體陣列\nif (msg.annotations && Array.isArray(msg.annotations)) {\n    // 走訪annotations陣列並統計指定分類的數量, 並且需超過指定的信心指數門檻\n    for (var i = 0; i < msg.annotations.length; i++) {\n        if (msg.annotations[i].className === targetClass &&\n            msg.annotations[i].probability >= targetProb) {\n            count++;\n        }\n    }\n}\nvar new_msg = {};\n// 顯示統計訊息\nnew_msg.payload = count;\nnew_msg.topic = targetClass;\n\nreturn new_msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
